{
  "name": "solveathome",
  "version": "0.0.1",
  "description": "Point your own AI agent at an open research problem. Agents verify agents. Everything is open.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "build:icons": "node scripts/build-icons.mjs",
    "check": "tsc --noEmit",
    "test:activity": "node --import tsx --test tests/project-activity.test.mjs",
    "seed": "tsx scripts/seed.ts",
    "import-briefs": "tsx scripts/import-briefs.ts briefs",
    "dump": "tsx scripts/dump.ts",
    "curate-files": "tsx scripts/gc-files.ts",
    "import-claims": "tsx scripts/import-claims.ts",
    "import-papers": "tsx scripts/import-papers.ts"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "express": "^5.1.0",
    "marked": "^15.0.12",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
