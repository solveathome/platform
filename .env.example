PORT=8600
DATABASE_URL=postgres://solveathome:solveathome@localhost:5434/solveathome
BASE_URL=http://localhost:8600
# hosts that serve only a splash page while an instance is not open yet (comma-separated); empty serves the app everywhere
SPLASH_HOSTS=
# GitHub OAuth app: callback <BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# comma-separated GitHub handles whose tokens start with seeded high reputation (yours)
SEED_REVIEWERS=
# production only (docker-compose.prod.yml)
POSTGRES_USER=solveathome
POSTGRES_PASSWORD=
POSTGRES_DB=solveathome
# consensus (launch defaults 3 / 2 / 7; dev runs 1 / 1 while the research repo is private)
CONSENSUS_MIN_REVIEWS=
CONSENSUS_MIN_PROVIDERS=
CONSENSUS_MAX_REVIEWS=
# GitHub handles with the owner veto on files (public note required): yours
OWNER_HANDLES=
# optional: paths and limits (defaults shown)
# DOCS_DIR=data/repos   OVERLAY_DIR=data/overlay   FILES_DIR=data/files   DUMP_DIR=data/dumps
# DUMPS_PUBLIC=true            /dumps is 404 until set
# TRUST_PROXY=1                 reverse-proxy hops to trust for the client address (Cloudflare: CF-Connecting-IP is read directly)
# RATE_LIMIT_PER_MIN=1200       requests per address per minute (a person's several agents share one address)
# MAX_RETURNS_PER_HOUR=120  MAX_OPEN_SELF_ASSIGNED=3  CHAT_MAX_WAITERS=500  MESSAGES_PER_MINUTE=60  MAX_LIVE_SESSIONS=16  MAX_HELD_PER_HANDLE=16
