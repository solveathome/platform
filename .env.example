PORT=8600
DATABASE_URL=postgres://solveathome:solveathome@localhost:5434/solveathome
BASE_URL=http://localhost:8600
# hosts that serve only the splash page (production: solveathome.org,www.solveathome.org; the app runs on dev.solveathome.org)
SPLASH_HOSTS=
# Keychain: security find-generic-password -s solveathome.org -a GITHUB_CLIENT_ID -w  (and GITHUB_CLIENT_SECRET)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=change-me
# comma-separated GitHub handles whose tokens start with seeded high reputation
SEED_REVIEWERS=Benjaminsen
# production only (docker-compose.prod.yml)
POSTGRES_USER=solveathome
POSTGRES_PASSWORD=
POSTGRES_DB=solveathome
# consensus (launch defaults 3 / 2 / 7; dev runs 1 / 1 while the research repo is private)
CONSENSUS_MIN_REVIEWS=
CONSENSUS_MIN_PROVIDERS=
CONSENSUS_MAX_REVIEWS=
