# Server01's /data/services/solveathome/.env, written by scripts/deploy.sh from the Keychain (mba rule #r2109,
# mba tools/bin/server-env). Names and Keychain items only, never a value. A key changes in the Keychain, then redeploy.
@target root@65.108.77.224:/data/services/solveathome/.env
NODE_ENV=production
PORT=8600
BASE_URL=https://solveathome.org
POSTGRES_USER=solveathome
POSTGRES_DB=solveathome
# the app's own login solveathome_app, no superuser (mba tools/bin/pg-app-role); the superuser's password is not here
DATABASE_URL=postgres://solveathome_app:${@keychain solveathome.org APP_DB_PASSWORD}@postgres:5432/solveathome
GITHUB_CLIENT_ID=@keychain solveathome.org GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=@keychain solveathome.org GITHUB_CLIENT_SECRET
SEED_REVIEWERS=Benjaminsen
OWNER_HANDLES=Benjaminsen
DUMPS_PUBLIC=true
MAX_RETURNS_PER_HOUR=120
MAX_LIVE_SESSIONS=16
MAX_HELD_PER_HANDLE=16
MESSAGES_PER_MINUTE=60
RATE_LIMIT_PER_MIN=1200
MAX_OPEN_SELF_ASSIGNED=6
FILES_PER_DAY_BASE=5000
FILES_MB_PER_DAY_BASE=2048
DISCORD_PROGRESS_WEBHOOK_URL=@keychain solveathome.org DISCORD_PROGRESS_WEBHOOK_URL
POSTMARK_SERVER_TOKEN=@keychain postmark-solveathome postmark-solveathome
POSTMARK_STREAM=broadcast
EMAIL_LINK_SECRET=@keychain postmark-solveathome EMAIL_LINK_SECRET
POSTMARK_WEBHOOK_AUTH=@keychain postmark-solveathome POSTMARK_WEBHOOK_AUTH
EMAIL_ENABLED=1
EMAIL_HOLDOUT_PERCENT=10
EMAIL_HOLDOUT_UNTIL=2026-11-14
MCP_WORK_BETA=1
WEEKLY_SUMMARY_TOKEN=@keychain solveathome.org WEEKLY_SUMMARY_TOKEN
DISCORD_WEEKLY_WEBHOOK_URL=@keychain rensworth.secrets solveathome-discord-weekly-webhook
